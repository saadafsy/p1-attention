# LF everywhere so byte-exact checks (the exp_lut.hex sha256 pin, include parsing) match on every checkout.
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.tcl  text eol=lf
*.sv   text eol=lf
*.svh  text eol=lf
*.v    text eol=lf
*.sby  text eol=lf
*.hex  text eol=lf
*.md   text eol=lf
Makefile text eol=lf
*.dat  binary
*.vcd  binary
