# matmul_tile formal: reset/clear/hold on all 384 acc_flat bits, load and
# accumulate on element (0,0). mac_unit asserts are removed (proven in
# mac_unit.sby). The other 15 elements and (i,j) wiring are checked in cocotb.
[options]
mode bmc
depth 5

[engines]
smtbmc z3

[script]
read_verilog -sv -formal -DFORMAL mac_unit.sv matmul_tile.sv
prep -top matmul_tile
chformal -assert -remove mac_unit

[files]
rtl/mac_unit.sv
rtl/matmul_tile.sv
