# attention_top formal: control-only BMC of the RTL FORMAL block (uarch 8.3):
# reset state, busy/done exclusion, done implies idle, cycle_count monotone,
# lane_out_valid one-hot-or-zero. Datapath values are checked in cocotb.
# The shortest run (n_len = 4) is 173 cycles, so depth 180 is needed to reach
# done; `cover` must reach done so `prove` is not vacuous.
# Submodule asserts are removed; each is proven in its own .sby.
# Engine: btormc finishes `prove` (about 29 min); smtbmc engines are far
# slower, and k-induction fails without strengthening invariants.
[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 180
cover: mode cover
cover: depth 180

[engines]
prove: btor btormc
cover: smtbmc yices

[script]
read_verilog -sv -formal -DFORMAL mac_unit.sv matmul_tile.sv exp_lut_1p.sv sync_ram.sv online_softmax.sv attention_top.sv
prep -top attention_top
chformal -assert -remove mac_unit
chformal -assert -remove matmul_tile
chformal -assert -remove online_softmax

[files]
rtl/mac_unit.sv
rtl/matmul_tile.sv
rtl/exp_lut_1p.sv
rtl/sync_ram.sv
rtl/online_softmax.sv
rtl/attention_top.sv
rtl/exp_lut.svh rtl/exp_lut.svh
